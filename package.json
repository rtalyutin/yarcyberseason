{
  "name": "ycs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/community-build.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:matchday": "node --test tests/matchday.test.mjs",
    "test:tournament": "node --test tests/tournament.test.mjs",
    "test:telegram": "node --test tests/telegram-contracts.test.mjs",
    "calendar:sync": "node scripts/community-build.mjs --sync",
    "test:community": "node --test tests/community*.test.mjs",
    "test:minesweeper": "node --test tests/minesweeper.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
